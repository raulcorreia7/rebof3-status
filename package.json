{
  "name": "rebof3-status",
  "private": true,
  "description": "Status page and picture renderer for the Breath of Fire III decompilation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node render/snapshot.ts site",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "tsc -p .",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "licenses": "license-checker-rseidelsohn --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0\" --excludePackages \"@resvg/resvg-js@2.6.2;@resvg/resvg-js-linux-x64-gnu@2.6.2;lightningcss@1.32.0;lightningcss@1.33.0;lightningcss-linux-x64-gnu@1.32.0;lightningcss-linux-x64-gnu@1.33.0;caniuse-lite@1.0.30001818;spdx-exceptions@2.5.0;spdx-ranges@2.1.1;spdx-license-ids@3.0.24\" --summary"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "dprint": "0.64.3",
    "echarts": "6.1.0",
    "license-checker-rseidelsohn": "5.0.1",
    "solid-js": "1.9.17",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
